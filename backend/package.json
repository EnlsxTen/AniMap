{
  "name": "animap-backend",
  "version": "1.0.0",
  "description": "Backend API for AniMap ACG event platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node dist/database/migrate.js",
    "migrate:dev": "ts-node src/database/migrate.ts",
    "reconcile-r2": "node dist/scripts/reconcileR2.js",
    "reconcile-r2:dev": "ts-node src/scripts/reconcileR2.ts"
  },
  "keywords": [
    "acg",
    "events",
    "map"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.11.3",
    "redis": "^5.12.1",
    "sharp": "^0.34.5",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.20.0",
    "@types/sharp": "^0.31.1",
    "@types/ssh2": "^1.15.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
